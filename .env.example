# PostgreSQL + PostGIS (docker compose)
POSTGRES_USER=caspian
POSTGRES_PASSWORD=caspian
POSTGRES_DB=caspian_breeze

# Backend. localhost — при запуске backend без docker; в docker compose адрес подменяется на db
DATABASE_URL=postgresql+psycopg://caspian:caspian@localhost:5432/caspian_breeze
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=https://caspian-breeze-.*\.vercel\.app
ADMIN_TOKEN=change-me
APP_ENV=dev
OSRM_URL=https://routing.openstreetmap.de/routed-foot

# Frontend
VITE_API_URL=http://localhost:8000
